<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="meridian" value="https://pkgs.dev.azure.com/CHANGE-ME/Meridian/_packaging/meridian/nuget/v3/index.json" />
  </packageSources>
  <!-- Dependency-confusion defense: Meridian.* may only come from the internal feed, everything else only from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="meridian">
      <package pattern="Meridian.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
