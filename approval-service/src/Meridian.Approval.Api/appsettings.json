{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Meridian": {
    "Auth": {
      "Mode": "EntraId",
      "RoleMappings": {
        "00000000-0000-0000-0000-00000000000a": "Approver",
        "00000000-0000-0000-0000-00000000000b": "Administrator"
      }
    }
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "CHANGE-ME",
    "ClientId": "CHANGE-ME",
    "Audience": "api://meridian-approvals"
  },
  "Storage": {
    "Provider": "Cosmos"
  },
  "Cosmos": {
    "AccountEndpoint": "",
    "DatabaseName": "meridian",
    "ContainerName": "approvals"
  },
  "Messaging": {
    "Provider": "StorageQueue",
    "QueueServiceUri": ""
  }
}
