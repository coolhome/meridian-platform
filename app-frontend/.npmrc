# All packages resolve through the Azure Artifacts feed (npmjs is an upstream), so the
# @meridian scope can never be shadowed by a public package. NpmAuthenticate@0 injects
# credentials in pipelines; locally run `npx vsts-npm-auth -config .npmrc` (Windows) or use a PAT.
registry=https://pkgs.dev.azure.com/coolhome/Meridian/_packaging/meridian/npm/registry/
always-auth=true
engine-strict=true
fund=false
audit=false
